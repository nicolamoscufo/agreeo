{
  "editor.fontFamily": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
  "editor.fontSize": 15,
  "editor.fontLigatures": false,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono, 'JetBrains Mono', 'Fira Code', monospace",
  "terminal.integrated.fontSize": 13,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/flutter/ephemeral": true,
    "**/Flutter/ephemeral": true,
    "**/.symlinks": true,
    "**/.plugin_symlinks": true
  }
}