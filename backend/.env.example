NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# Strong password required in production (the server refuses to start without it).
NEO4J_PASSWORD=change_me_strong_password
NEO4J_DATABASE=neo4j

# Must be a cryptographically random value of at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_random_secret_of_at_least_32_chars

TMDB_ACCESS_TOKEN=your_tmdb_bearer_token

ENABLE_DAILY_SWIPE_LIMIT=false
DAILY_SWIPE_LIMIT=999999
# Keep the recommendation debug endpoint disabled outside local development.
ENABLE_RECOMMENDATION_DEBUG=false
