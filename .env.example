# Copy this file to .env before running docker compose locally.
# Keep real values out of git.

# Strong password required: docker compose fails to start without it.
NEO4J_PASSWORD=change_me_strong_password

# Must be a cryptographically random value of at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_random_secret_of_at_least_32_chars

TMDB_ACCESS_TOKEN=your_tmdb_bearer_token
BACKEND_BASE_URL=http://localhost:3000

# Abilita la console Neo4j read-only in-app (Settings > Developer).
# Solo per demo/sviluppo: espone schema, indici e query Cypher agli utenti autenticati.
ENABLE_NEO4J_DEBUG=true

# Enforced from persisted daily-suggestion swipe events, not per request.
ENABLE_DAILY_SWIPE_LIMIT=true
DAILY_SWIPE_LIMIT=20
ENABLE_RECOMMENDATION_DEBUG=false
ENABLE_RECOMMENDATION_AB_TEST=false
SEMANTIC_TOP_K=25
SEMANTIC_SIMILARITY_THRESHOLD=0.35
SEMANTIC_NEGATIVE_PENALTY=0.75
SEMANTIC_RRF_WEIGHT=0.85
AB_SEMANTIC_WEIGHT=1.0
RECIPROCAL_RANK_K=60
COLLABORATIVE_NEIGHBOR_LIMIT=50
COLLABORATIVE_SUPPORT_SHRINKAGE=5.0
RECOMMENDATION_CACHE_TTL_MS=5000
EMBEDDING_MODEL_ID=Xenova/multilingual-e5-small
EMBEDDING_MODEL_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
