# Copy this file to .env.azure on the Azure VM.
# Keep real values out of git.

NEO4J_PASSWORD=replace_with_a_strong_neo4j_password
JWT_SECRET=replace_with_a_long_random_jwt_secret
TMDB_ACCESS_TOKEN=your_tmdb_bearer_token

# Use the VM public IP or domain. Include the backend port unless you add a reverse proxy.
BACKEND_BASE_URL=http://your-vm-public-ip:3000
BACKEND_PUBLIC_PORT=3000
FRONTEND_PUBLIC_PORT=80

# Keep Neo4j admin ports private to the VM by default. Use SSH tunneling to access them.
NEO4J_HTTP_BIND=127.0.0.1
NEO4J_BOLT_BIND=127.0.0.1
